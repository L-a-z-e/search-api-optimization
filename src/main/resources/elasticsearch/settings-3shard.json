{
  "index": {
    "number_of_shards": 3,
    "number_of_replicas": 0,
    "refresh_interval": "5s"
  },
  "analysis": {
    "tokenizer": {
      "nori_mixed": {
        "type": "nori_tokenizer",
        "decompound_mode": "mixed"
      }
    },
    "filter": {
      "nori_pos_filter": {
        "type": "nori_part_of_speech",
        "stoptags": [
          "E", "IC", "J", "MAG", "MAJ",
          "MM", "SP", "SSC", "SSO", "SC",
          "SE", "XPN", "XSA", "XSN", "XSV",
          "UNA", "NA", "VSV", "VCP", "VCN",
          "VX"
        ]
      }
    },
    "analyzer": {
      "korean_analyzer": {
        "type": "custom",
        "tokenizer": "nori_mixed",
        "filter": [
          "nori_pos_filter",
          "lowercase"
        ]
      }
    }
  }
}
